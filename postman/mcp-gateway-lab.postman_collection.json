    {
      "name": "Tool calls through the gateway",
      "description": "One JSON-RPC-shaped tool call at a time. In-scope calls forward to the (mock) third-party weather server; out-of-scope calls are denied with 403 and the backend never sees them.",
      "item": [
        {
          "name": "Forward: in-scope city",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Forward: in-scope city\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().decision).to.eql('forward');",
                  "  pm.expect(pm.response.json()).to.have.property('weather');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool\": \"get_current_conditions\",\n  \"arguments\": {\n    \"city_name\": \"Dallas\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/weather/tool",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "weather",
                "tool"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Deny: out-of-scope city",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Deny: out-of-scope city\", function () {",
                  "  pm.expect(pm.response.code).to.eql(403);",
                  "  pm.expect(pm.response.json().decision).to.eql('denied');",
                  "  pm.expect(pm.response.json()).to.not.have.property('weather');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool\": \"get_current_conditions\",\n  \"arguments\": {\n    \"city_name\": \"Denver\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/weather/tool",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "weather",
                "tool"
