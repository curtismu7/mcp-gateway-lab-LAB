{
  "info": {
    "name": "MCP Gateway LAB",
    "description": "API collection for MCP Gateway LAB: the simulated MCP gateway's policy surface. Set a policy, call the third-party weather tools through the gateway (in-scope forwards, out-of-scope denies and never reach the backend), browse the decision runs, and read the scenario catalog and diagrams. The lab is a labelled simulation; there is no live mode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "postman-mcp-gateway-lab"
  },
  "item": [
    {
      "name": "Sanity (simulated, labelled)",
      "description": "Health, mode info (always simulated) and the scenario/diagram catalogs.",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().state).to.eql('ready');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/health",
